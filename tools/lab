#!/usr/bin/env bash
#
# lab - drive tools/bc250_lab.sh on the board from a dev machine.
#
# Ships the harness (and, for `build work`, the working tree) to the board and
# runs one lab command over ssh. Exists because every measurement this session
# was a hand-rolled scp+ssh, and two bugs came from quoting: PowerShell mangles
# inline pipes/quotes/$vars before wsl ever sees them, so commands must travel
# as a FILE, never as an inline string.
#
# This is the canonical way to measure this encoder - see
# docs/performance-measurement.md. Do not hand-roll a fresh ffmpeg script;
# the validity rules that live in this harness were all learned by getting
# them wrong first.
#
# USAGE
#   tools/lab setup                          one-time board setup
#   tools/lab build work|local:<ref>|<ref>   build -> prints a <key>
#
#   tools/lab noise <key> --repeat=5         the floor; run this FIRST
#   tools/lab bench <key> [opts]             one measurement, TSV
#   tools/lab compare <keyA> <keyB>          A/B, significance-tested
#   tools/lab scoreboard <key> [--quality]   vs libx264, per load condition
#
#   tools/lab quality <key>                  PSNR/SSIM
#   tools/lab qsweep <key> [--codec=hevc]    PSNR/SSIM across bitrates
#   tools/lab exact <keyA> <keyB>            byte-exactness (deterministic only)
#   tools/lab audit <key>                    nonzero-mask exactness audit
#   tools/lab units <key>                    unit tests
#   tools/lab drift <key> [--codec=hevc]     recon vs a REAL decoder, byte-exact
#   tools/lab gate <key> [<baseKey>]         audit + units + quality + drift + exact
#
#   tools/lab health                         is the live Sunshine healthy?
#   tools/lab deploy <key>                   install, health-check, auto-rollback
#   tools/lab rollback                       restore the previous driver
#
# `tools/lab help` prints the harness's own full help, including every
# bench/noise option. That one needs the board; the summary above does not.
#
# ENVIRONMENT
#   BC250_HOST   default user@10.0.0.104
#   BC250_PASS   password for sshpass (or set up a key and unset this)
#   BC250_SSH    override the whole ssh command
#
set -uo pipefail

# Answer -h/--help locally. Previously any help request still shipped the
# harness to the board and asked it, so you could not even see the command
# list with the board powered down or mid-reflash.
case "${1:-}" in
    -h|--help|"")
        awk 'NR>1 { if (/^#/) { sub(/^# ?/, ""); print } else { exit } }' "${BASH_SOURCE[0]}"
        exit 0
        ;;
esac

HOST="${BC250_HOST:-user@10.0.0.104}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Must track bc250_lab.sh's own $LAB default/override exactly - this script
# ships the harness there and bc250_lab.sh reads/writes state there too.
# Was hardcoded to Bazzite's /var/home/user path; broke outright on a
# CachyOS reimage where the login is a different user at plain /home.
LAB_REMOTE="${BC250_LAB_DIR:-/var/home/user/bc250-lab}"

# Keepalive is not optional. A `lab build work` here hung for 76 MINUTES on
# `ssh ... mkdir -p`, of all things: the board had been power-cycled under a
# previously-established TCP connection, so the socket was never reset and
# ssh waited forever on a dead peer. A fresh ssh to the same board answered
# instantly throughout. Without ServerAlive* there is no upper bound on that
# wait, and the failure looks exactly like "the build is just slow" - the
# stall is invisible because the output is still buffered behind a pipe.
# 15s x 4 gives up after ~1 minute of silence from a peer that has gone away.
# (A stale `ssh ... uname -a` from a session two DAYS earlier was still
# parked in the process table when this was found.)
KEEPALIVE=(-o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o ConnectTimeout=10)

if [ -n "${BC250_SSH:-}" ]; then
    SSH=(${BC250_SSH})
    SCP=(scp "${KEEPALIVE[@]}")
elif [ -n "${BC250_PASS:-}" ]; then
    SSH=(sshpass -p "$BC250_PASS" ssh -n -o StrictHostKeyChecking=no "${KEEPALIVE[@]}")
    SCP=(sshpass -p "$BC250_PASS" scp -o StrictHostKeyChecking=no "${KEEPALIVE[@]}")
else
    SSH=(ssh -n -o StrictHostKeyChecking=no "${KEEPALIVE[@]}")
    SCP=(scp -o StrictHostKeyChecking=no "${KEEPALIVE[@]}")
fi

# `ssh -n` is mandatory here: ssh inside a pipeline otherwise consumes stdin
# and swallows the rest of the caller's script. It also nulls stdin, which is
# why nothing below uses a heredoc over the wire.
# Forward the harness's own tunables to the board. Without this, setting
# something like BC250_CPU_LOAD_N locally silently has no effect, because the
# remote bash gets a fresh environment - a quiet way to believe you measured
# a condition you never actually applied.
FORWARD=""
for v in BC250_CPU_LOAD_N BC250_SW_PRESET BC250_SW_TUNE BC250_SW_THREADS \
         BC250_LAB_DIR BC250_DRV_DIR BC250_DISTROBOX BC250_RENDER BC250_LAB_REPO; do
    eval "val=\${$v:-}"
    [ -n "$val" ] && FORWARD="$FORWARD $v=$(printf '%q' "$val")"
done

sh_remote() { "${SSH[@]}" "$HOST" "env$FORWARD bash $LAB_REMOTE/bc250_lab.sh $*"; }

cmd="${1:-}"

# Always refresh the harness itself, so the board can never run a stale copy.
"${SSH[@]}" "$HOST" "mkdir -p $LAB_REMOTE" >/dev/null 2>&1
"${SCP[@]}" -q "$REPO_ROOT/tools/bc250_lab.sh" "$REPO_ROOT/tools/bc250_lab_parse.py" \
    "$HOST:$LAB_REMOTE/" || { echo "lab: failed to ship harness" >&2; exit 1; }

# Source that the board's own clone cannot see has to be shipped:
#
#   build work         the uncommitted working tree
#   build local:<ref>  any LOCAL commit/tag, including unpushed ones
#
# The second form matters more than it looks. Without it, measuring a commit
# requires pushing it first, which couples "I want a number" to "the world
# sees this" - and the whole point of the harness is to get the number before
# deciding whether to publish. The board keys the build by the tarball's md5,
# so a given ref content-addresses to a stable key and stays cached.
if [ "$cmd" = build ] && [ -n "${2:-}" ]; then
    target="$2"
    tmp=$(mktemp -d)
    case "$target" in
        work)
            tar czf "$tmp/work-src.tar.gz" -C "$REPO_ROOT" \
                --exclude=build --exclude='*.o' approach1-compute-encoder || exit 1
            ;;
        local:*)
            ref="${target#local:}"
            git -C "$REPO_ROOT" rev-parse --verify --quiet "$ref^{commit}" >/dev/null \
                || { echo "lab: no such local ref '$ref'" >&2; exit 1; }
            git -C "$REPO_ROOT" archive --format=tar.gz -o "$tmp/work-src.tar.gz" \
                "$ref" approach1-compute-encoder || exit 1
            echo "# shipping local ref $ref ($(git -C "$REPO_ROOT" rev-parse --short "$ref"))" >&2
            set -- build work
            ;;
    esac
    if [ -f "$tmp/work-src.tar.gz" ]; then
        "${SCP[@]}" -q "$tmp/work-src.tar.gz" "$HOST:$LAB_REMOTE/work-src.tar.gz" || exit 1
    fi
    rm -rf "$tmp"
fi

sh_remote "$@"
