/* bc250-vcn-driver v0.2.0 - https://github.com/Kai/bc250-vcn-driver */
#version 450
layout(local_size_x = 32) in; // Wave32 aligned

layout(std430, set = 0, binding = 0) readonly buffer InputCoeffs {
    int coeffs[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputLevels {
    int levels[];
};

/* Per-4x4-block nonzero BITMASK (bit p set iff levels[p] != 0), one uint per
 * block. This used to hold a plain nonzero COUNT that nothing ever read - the
 * buffer was device-local with no host staging and no CPU consumer. A mask is
 * strictly more informative than the count (the count is its popcount) and is
 * what encoder_h264.c actually needs: every "does this block have a nonzero
 * coefficient in positions [start,end)" question it asks - the P_Skip
 * decision, cbp_luma, cbp_chroma, the CAVLC per-block early-out - becomes a
 * bit test against this instead of a fresh 64-byte read out of the (22MB at
 * 1440p) quant_levels readback. See gpu_compute.h's nz_staging_buffers. */
layout(std430, set = 0, binding = 2) writeonly buffer NonZeroMask {
    uint nzc[];
};

layout(push_constant) uniform PushConstants {
    uint frame_width;
    uint frame_height;
    uint width_in_mbs;
    uint height_in_mbs;
    uint qp;
    uint is_intra;
    uint color_space;
    uint lambda_motion;
} pcs;

// H.264 Multiplication Factor Table (ITU-T Rec. H.264 section 8.5.9 Table 8-14)
// Indices: [qp % 6][position_type]
// position_type: 0 for (0,0),(0,2),(2,0),(2,2); 1 for (1,1),(1,3),(3,1),(3,3); 2 for other positions
const int MF[6][3] = {
    {13107, 5243, 8066},
    {11916, 4660, 7490},
    {10082, 4194, 6554},
    {9362,  3647, 5825},
    {8192,  3355, 5243},
    {7282,  2893, 4559}
};

int get_pos_type(int idx) {
    int r = idx / 4;
    int c = idx % 4;
    int r_even = r & 1;
    int c_even = c & 1;
    if (r_even == 0 && c_even == 0) return 0;
    if (r_even == 1 && c_even == 1) return 1;
    return 2;
}

/* ITU-T H.264 Table 8-15: QPc = f(qPI), qPI = Clip3(-QpBdOffsetC, 51, QPy +
 * chroma_qp_index_offset). This project always signals
 * chroma_qp_index_offset = 0 (bitstream.c) and 8-bit-only (QpBdOffsetC = 0),
 * so qPI reduces to QPy itself, clamped to [0,51] (QPy is already in that
 * range by construction). Identity for qPI<30; a real decoder applies this
 * exact table to derive the chroma quantizer from the signaled luma QP -
 * this was previously MISSING, so chroma was quantized/dequantized at QPy
 * directly instead of QPc, silently diverging further from a real decoder's
 * reconstruction as QP rises past 30 (QPc grows much slower than QPy up
 * there). Confirmed on real hardware: at QP=42 this cost ~13dB of chroma
 * PSNR against a real decode, while luma was unaffected - see
 * docs/DEVLOG.md for the measurement. */
int chroma_qp(int qpy) {
    if (qpy < 30) return qpy;
    const int table[22] = {29,30,31,32,32,33,34,34,35,35,36,36,37,37,37,38,38,38,39,39,39,39};
    int idx = qpy - 30;
    return table[idx < 22 ? idx : 21];
}

void main() {
    uint mb_x = gl_WorkGroupID.x;
    uint mb_y = gl_WorkGroupID.y;
    if (mb_x >= pcs.width_in_mbs || mb_y >= pcs.height_in_mbs) return;

    uint block_idx = gl_LocalInvocationIndex;
    if (block_idx >= 24) return;

    uint mb_idx = mb_y * pcs.width_in_mbs + mb_x;
    uint global_block_idx = mb_idx * 24 + block_idx;

    /* Blocks 0-15 are luma (4x4 each), 16-23 are chroma (8x 4x4: 4 Cb + 4
     * Cr) - see this file's callers / the file-top layout comment in
     * reconstruct.comp. Chroma must quantize at QPc, not QPy. */
    int qp_used = (block_idx < 16) ? int(pcs.qp) : chroma_qp(int(pcs.qp));
    int qp_per = qp_used / 6;
    int qp_rem = qp_used % 6;

    // Rounding offset: 1/3 for intra, 1/6 for inter
    int f = (1 << (15 + qp_per)) / (pcs.is_intra == 1 ? 3 : 6);
    uint nz_mask = 0;

    for (int i = 0; i < 16; i++) {
        int coeff = coeffs[global_block_idx * 16 + i];
        int sign = coeff < 0 ? -1 : 1;
        int abs_coeff = abs(coeff);

        int pos_type = get_pos_type(i);
        int level = (abs_coeff * MF[qp_rem][pos_type] + f) >> (15 + qp_per);
        level *= sign;

        levels[global_block_idx * 16 + i] = level;
        if (level != 0) nz_mask |= (1u << uint(i));
    }

    nzc[global_block_idx] = nz_mask;
}
