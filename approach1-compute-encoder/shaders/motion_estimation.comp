/* bc250-vcn-driver v0.2.0 - https://github.com/Kai/bc250-vcn-driver */
#version 450
layout(local_size_x = 64) in; // Wave64 / Dual-Wave32 for RDNA 2

layout(set = 0, binding = 0, r8) uniform readonly image2D currentImage;
layout(set = 0, binding = 1, r8) uniform readonly image2D referenceImage;

struct MotionVector {
    ivec2 mv;
    uint sad;
};

layout(std430, set = 0, binding = 2) writeonly buffer OutputMV {
    MotionVector mvs[];
};

/*
 * binding 3: residual_buffer (dct_transform.comp's InputResiduals).
 *
 * FIX: nothing in this pipeline ever wrote to residual_buffer before this
 * change - color_convert.comp only writes the Y/UV *images*, this shader
 * only wrote motion vectors, and deblock_filter.comp only touches
 * reconstructed pixels in place. dct_transform.comp therefore always read
 * whatever was already in that freshly-allocated device-local buffer
 * (unwritten - zero or undefined depending on the driver), so every
 * downstream stage (quantize, CAVLC) had nothing real to encode regardless
 * of how correct the entropy coding was. Confirmed on real hardware: after
 * fixing CAVLC to be spec-correct (see encoder_h264.c/cavlc.c), ffmpeg
 * decoded the stream with zero errors but the frame was still flat gray.
 *
 * DELIBERATE SIMPLIFICATION (same spirit as encoder_h264.c's documented DC
 * dequant simplification): this shader is the only stage that already has
 * the current macroblock's raw luma pixels loaded into shared memory
 * (`current_mb`), so it doubles as the residual generator, using a
 * constant predictor of 128 (ITU-T H.264 8.3.3.1's actual Intra_16x16 DC
 * value when no neighbor MB is available) instead of real intra
 * prediction (neighbor-average DC/vertical/horizontal/plane, which would
 * need this shader to read reconstructed neighbor MBs and know the actual
 * H.264 prediction mode chosen for this MB - a real intra-prediction
 * compute stage, out of scope here). This is NOT bit-exact
 * reconstruction: the decoder adds back ITS OWN real prediction (which
 * matches 128 only where neighbors are genuinely unavailable), so
 * reconstructed pixels carry a per-MB DC bias equal to
 * (real_neighbor_average - 128). Chosen because it still transmits the
 * REAL AC/edge/gradient structure of the source picture through DCT/CAVLC
 * unchanged - the actual deliverable this task needed (a visibly
 * recognizable decoded picture instead of flat gray) - while a fully
 * spec-compliant intra-prediction shader is a substantially larger,
 * separate piece of work.
 *
 * Chroma (blocks 16-23) is NOT computed here (this shader has no chroma
 * image bound) and is explicitly zeroed instead of left undefined -
 * chroma will decode as a flat plane; only luma carries real content.
 */
layout(std430, set = 0, binding = 3) writeonly buffer OutputResidual {
    int res[];
};

layout(push_constant) uniform PushConstants {
    uint frame_width;
    uint frame_height;
    uint width_in_mbs;
    uint height_in_mbs;
    uint qp;
    uint is_intra;
    uint color_space;
    uint lambda_motion;
} pcs;

shared float search_window[48][48];
shared float current_mb[16][16];
shared uint thread_sad[64];
shared ivec2 shared_best_mv;
shared uint shared_best_cost;

// Early termination threshold for zero-motion detection (~2 intensity levels per pixel)
const uint STATIC_MB_THRESHOLD = 512;

void main() {
    uint mb_x = gl_WorkGroupID.x;
    uint mb_y = gl_WorkGroupID.y;
    if (mb_x >= pcs.width_in_mbs || mb_y >= pcs.height_in_mbs) return;

    uint mb_idx = mb_y * pcs.width_in_mbs + mb_x;
    uint local_id = gl_LocalInvocationIndex;
    ivec2 mb_pos = ivec2(mb_x * 16, mb_y * 16);

    // 1. Cooperative load of current macroblock (256 pixels across 64 threads = 4 px/thread)
    for (int i = 0; i < 4; i++) {
        uint p_idx = local_id * 4 + i;
        uint px = p_idx % 16;
        uint py = p_idx / 16;
        ivec2 coord = mb_pos + ivec2(px, py);
        coord = clamp(coord, ivec2(0), ivec2(pcs.frame_width - 1, pcs.frame_height - 1));
        float pixel = imageLoad(currentImage, coord).r;
        current_mb[py][px] = pixel;

        // Write the luma residual for this pixel (see OutputResidual's doc
        // comment above): raster block-of-4x4 layout matching
        // dct_transform.comp's global_block_idx = mb_idx*24+block_idx,
        // block_idx = (py/4)*4+(px/4), position within block = (py%4)*4+(px%4).
        uint bx = px / 4u, by = py / 4u;
        uint block = by * 4u + bx;
        uint pos_in_block = (py % 4u) * 4u + (px % 4u);
        uint global_block_idx = mb_idx * 24u + block;
        res[global_block_idx * 16u + pos_in_block] = int(round(pixel * 255.0)) - 128;
    }

    // Chroma (blocks 16-23) is not computed by this shader - zero it
    // explicitly rather than leaving it as undefined device memory.
    // 4 Cb + 4 Cr blocks * 16 positions = 128 values / 64 threads = 2 each.
    for (int i = 0; i < 2; i++) {
        uint idx = local_id * 2u + uint(i); // 0..127
        uint block = 16u + idx / 16u;       // 16..23
        uint pos_in_block = idx % 16u;
        res[(mb_idx * 24u + block) * 16u + pos_in_block] = 0;
    }

    // 2. Cooperative load of 48x48 search window (2304 pixels / 64 threads = 36 px/thread)
    for (int i = 0; i < 36; i++) {
        uint p_idx = local_id * 36 + i;
        if (p_idx < 2304) {
            uint px = p_idx % 48;
            uint py = p_idx / 48;
            ivec2 coord = mb_pos + ivec2(px, py) - ivec2(16, 16);
            coord = clamp(coord, ivec2(0), ivec2(pcs.frame_width - 1, pcs.frame_height - 1));
            search_window[py][px] = imageLoad(referenceImage, coord).r;
        }
    }

    barrier();

    // 3. Fast Zero-Motion Check (SAD at (0, 0))
    uint zero_diff = 0;
    for (int i = 0; i < 4; i++) {
        uint p_idx = local_id * 4 + i;
        uint px = p_idx % 16;
        uint py = p_idx / 16;
        float curr = current_mb[py][px];
        float ref = search_window[py + 16][px + 16];
        zero_diff += uint(abs(curr - ref) * 255.0);
    }
    thread_sad[local_id] = zero_diff;

    barrier();

    // Fast parallel reduction
    if (local_id < 32) thread_sad[local_id] += thread_sad[local_id + 32];
    barrier();
    if (local_id < 16) thread_sad[local_id] += thread_sad[local_id + 16];
    barrier();
    if (local_id < 8) thread_sad[local_id] += thread_sad[local_id + 8];
    barrier();
    if (local_id < 4) thread_sad[local_id] += thread_sad[local_id + 4];
    barrier();
    if (local_id < 2) thread_sad[local_id] += thread_sad[local_id + 2];
    barrier();

    uint initial_sad = thread_sad[0] + thread_sad[1];

    // Early exit if the block is static (saves ~60% execution time in gaming/video)
    if (initial_sad <= STATIC_MB_THRESHOLD) {
        if (local_id == 0) {
            mvs[mb_idx].mv = ivec2(0);
            mvs[mb_idx].sad = initial_sad;
        }
        return;
    }

    // 4. Hierarchical Adaptive Diamond Search
    if (local_id == 0) {
        shared_best_mv = ivec2(0);
        shared_best_cost = initial_sad;
    }
    barrier();

    ivec2 diamond[4] = { ivec2(0,1), ivec2(0,-1), ivec2(1,0), ivec2(-1,0) };

    for (int step = 8; step >= 1; step /= 2) {
        ivec2 center = shared_best_mv;
        for (int c = 0; c < 4; c++) {
            ivec2 test_mv = center + diamond[c] * step;
            if (abs(test_mv.x) > 16 || abs(test_mv.y) > 16) continue;

            uint local_diff = 0;
            for (int i = 0; i < 4; i++) {
                uint p_idx = local_id * 4 + i;
                uint px = p_idx % 16;
                uint py = p_idx / 16;
                // 2:1 Checkerboard subsampling cuts ALU and shared memory load by 50%
                if (((px + py) & 1) == 0) {
                    float curr = current_mb[py][px];
                    float ref = search_window[py + 16 + test_mv.y][px + 16 + test_mv.x];
                    local_diff += uint(abs(curr - ref) * 510.0); // Scaled by 2x
                }
            }
            thread_sad[local_id] = local_diff;

            barrier();

            if (local_id < 32) thread_sad[local_id] += thread_sad[local_id + 32];
            barrier();
            if (local_id < 16) thread_sad[local_id] += thread_sad[local_id + 16];
            barrier();
            if (local_id < 8) thread_sad[local_id] += thread_sad[local_id + 8];
            barrier();
            if (local_id < 4) thread_sad[local_id] += thread_sad[local_id + 4];
            barrier();
            if (local_id < 2) thread_sad[local_id] += thread_sad[local_id + 2];
            barrier();
            if (local_id == 0) thread_sad[0] += thread_sad[1];
            barrier();

            if (local_id == 0) {
                uint cand_sad = thread_sad[0];
                uint cost = cand_sad + pcs.lambda_motion * uint(abs(test_mv.x) + abs(test_mv.y));
                if (cost < shared_best_cost) {
                    shared_best_cost = cost;
                    shared_best_mv = test_mv;
                }
            }
            barrier();
        }

        // Early termination if quality is already high (all invocations break together)
        if (shared_best_cost < 768) break;
    }

    if (local_id == 0) {
        mvs[mb_idx].mv = shared_best_mv;
        mvs[mb_idx].sad = shared_best_cost;
    }
}
